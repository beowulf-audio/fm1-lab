+/// FM1_FLASH_JEDEC: a 3-byte JEDEC id in hex (`b36014`, `0xB36014`), if set and valid.
+pub fn jedec_from_env() -> Option<[u8; 3]> {
+    let v = std::env::var("FM1_FLASH_JEDEC").ok()?;
+    let v = v.trim().trim_start_matches("0x").trim_start_matches("0X");
+    if v.len() != 6 { return None; }
+    let id = u32::from_str_radix(v, 16).ok()?;
+    Some([(id >> 16) as u8, (id >> 8) as u8, id as u8])
+}
