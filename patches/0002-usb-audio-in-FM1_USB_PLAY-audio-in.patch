+/// Live: what the computer plays to the device, kept about 46 ms ahead of the bus: a WAV file
+/// (FM1_USB_PLAY, looped) or this computer's audio input (--audio-in, resampled to 44.1 kHz; when
+/// its clock runs ahead of the emulator's, the oldest input is dropped beyond 200 ms).
+struct LiveFeed {
+    file: Option<(Vec<i16>, usize)>,
+    input: Option<Arc<Mutex<VecDeque<f32>>>>,
+    /// input frames per 44.1 kHz frame
+    step: f64,
+    pos: f64,
+    prev: (f32, f32),
+    next: (f32, f32),
+}
+
+impl LiveFeed {
+    const AHEAD: usize = 2048;
+    fn service(&mut self, m: &mut Machine) {
+        if !m.soc.usb.playing() {
+            if let Some(q) = &self.input {
+                q.lock().unwrap().clear(); // (nothing takes it yet: don't let it pile up)
+            }
+            return;
+        }
+        let mut chunk = Vec::with_capacity(512);
+        while m.soc.usb.play_queued() < Self::AHEAD {
+            chunk.clear();
+            if let Some((lr, at)) = self.file.as_mut() {
+                for _ in 0..512 {
+                    chunk.push(lr[*at]);
+                    *at = (*at + 1) % lr.len();
+                }
+            } else if let Some(q) = &self.input {
+                let mut q = q.lock().unwrap();
+                let keep = (self.step * 44_100.0 * 0.2) as usize;   // 200 ms of input frames
+                if q.len() > 2 * keep {
+                    let drop = (q.len() - 2 * keep) & !1;
+                    q.drain(..drop);
+                }
+                for _ in 0..256 {
+                    let mut starved = false;
+                    self.pos += self.step;
+                    while self.pos >= 1.0 {
+                        if q.len() < 2 {
+                            starved = true;
+                            break;
+                        }
+                        self.pos -= 1.0;
+                        self.prev = self.next;
+                        self.next = (q.pop_front().unwrap(), q.pop_front().unwrap());
+                    }
+                    if starved {
+                        self.pos -= self.step;
+                        break;
+                    }
+                    let t = self.pos as f32;
+                    let l = self.prev.0 + (self.next.0 - self.prev.0) * t;
+                    let r = self.prev.1 + (self.next.1 - self.prev.1) * t;
+                    chunk.push((l * 32767.0).round().clamp(-32768.0, 32767.0) as i16);
+                    chunk.push((r * 32767.0).round().clamp(-32768.0, 32767.0) as i16);
+                }
+            }
+            if chunk.is_empty() {
+                break; // the input has nothing more yet
+            }
+            m.soc.usb.play_push(&chunk);
+            if chunk.len() < 512 && self.file.is_none() {
+                break;
+            }
+        }
+        m.soc.usb.play_trim(4 * Self::AHEAD);
+    }
+}
