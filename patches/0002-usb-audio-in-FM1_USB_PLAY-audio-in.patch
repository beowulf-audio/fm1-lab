+/// The playback interface of a configuration (an audio streaming interface, class 1, subclass
+/// 2): the first alternate setting with an isochronous OUT data endpoint (its class-specific
+/// endpoint descriptor follows it), and the Type I format descriptor in it.
+pub fn find_playback(conf: &[u8]) -> Option<AudioStream> {
+    let mut i = 0usize;
+    let (mut cur, mut pending): (Option<AudioStream>, Option<(u8, u16)>) = (None, None);
+    let done = |a: &Option<AudioStream>| a.as_ref().is_some_and(|a| a.ep != 0);
+    while i + 2 <= conf.len() {
+        let (len, ty) = (conf[i] as usize, conf[i + 1]);
+        if len < 2 || i + len > conf.len() {
+            break;
+        }
+        let d = &conf[i..i + len];
+        match ty {
+            4 if len >= 9 => {
+                if done(&cur) {
+                    break;
+                }
+                cur = (d[5] == 1 && d[6] == 2).then(|| AudioStream { interface: d[2], alt: d[3], ..Default::default() });
+                pending = None;
+            }
+            0x24 if len >= 8 && d[2] == 2 && d[3] == 1 => {
+                if let Some(a) = cur.as_mut() {
+                    a.channels = d[4];
+                    a.sample_bytes = d[5];
+                    let n = d[7] as usize;
+                    let at = |k: usize| u32::from(d[k]) | u32::from(d[k + 1]) << 8 | u32::from(d[k + 2]) << 16;
+                    if n == 0 && len >= 14 {
+                        a.rate_range = Some((at(8), at(11)));
+                    } else {
+                        a.rates = (0..n).filter(|k| 8 + 3 * k + 3 <= len).map(|k| at(8 + 3 * k)).collect();
+                    }
+                }
+            }
+            5 if len >= 7 && d[3] & 3 == 1 => {
+                pending = (d[2] & 0x80 == 0 && cur.as_ref().is_some_and(|a| a.ep == 0)).then(|| (d[2], u16::from_le_bytes([d[4], d[5]])));
+            }
+            0x25 if len >= 4 && d[2] == 1 => {
+                if let (Some(a), Some((ep, maxp))) = (cur.as_mut(), pending.take()) {
+                    (a.ep, a.max_packet, a.rate_control) = (ep, maxp, d[3] & 1 != 0);
+                }
+            }
+            _ => pending = None,
+        }
+        i += len;
+    }
+    if done(&cur) { cur } else { None }
+}
