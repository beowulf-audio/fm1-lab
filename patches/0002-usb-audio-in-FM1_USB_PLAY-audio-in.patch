+/// --audio-in NAME: this computer's audio input (part of its name, case-insensitive, or
+/// "default") into `q` as interleaved stereo f32; its name and rate. (macOS asks once for the
+/// microphone permission of the terminal that runs this.)
+fn start_input(name: &str, q: Arc<Mutex<VecDeque<f32>>>) -> Result<(cpal::Stream, String, f64), String> {
+    let host = cpal::default_host();
+    let dev = if name == "default" {
+        host.default_input_device()
+    } else {
+        let want = name.to_lowercase();
+        host.input_devices().map_err(|e| e.to_string())?.find(|d| d.name().is_ok_and(|n| n.to_lowercase().contains(&want)))
+    };
+    let Some(dev) = dev else {
+        let names: Vec<String> = host.input_devices().map(|ds| ds.filter_map(|d| d.name().ok()).collect()).unwrap_or_default();
+        return Err(format!("no audio input matching \"{name}\" (inputs: {})", if names.is_empty() { "none".into() } else { names.join(", ") }));
+    };
+    let dname = dev.name().unwrap_or_default();
+    let cfg = dev.default_input_config().map_err(|e| e.to_string())?;
+    let ch = cfg.channels() as usize;
+    let rate = cfg.sample_rate().0 as f64;
+    let cap = rate as usize;                              // at most a second waiting
+    let err = |e: cpal::StreamError| eprintln!("audio in: {e}");
+    let stream = match cfg.sample_format() {
+        cpal::SampleFormat::F32 => dev.build_input_stream(&cfg.config(), move |data: &[f32], _: &cpal::InputCallbackInfo| {
+            let mut q = q.lock().unwrap();
+            for f in data.chunks(ch) {
+                q.push_back(f[0]);
+                q.push_back(if ch > 1 { f[1] } else { f[0] });
+            }
+            while q.len() > 2 * cap {
+                q.pop_front();
+                q.pop_front();
+            }
+        }, err, None),
+        cpal::SampleFormat::I16 => dev.build_input_stream(&cfg.config(), move |data: &[i16], _: &cpal::InputCallbackInfo| {
+            let mut q = q.lock().unwrap();
+            for f in data.chunks(ch) {
+                q.push_back(f[0] as f32 / 32768.0);
+                q.push_back(if ch > 1 { f[1] } else { f[0] } as f32 / 32768.0);
+            }
+            while q.len() > 2 * cap {
+                q.pop_front();
+                q.pop_front();
+            }
+        }, err, None),
+        f => return Err(format!("input format {f:?} not handled (f32 or i16 only)")),
+    }
+    .map_err(|e| e.to_string())?;
+    stream.play().map_err(|e| e.to_string())?;
+    Ok((stream, dname, rate))
+}
