+/// FM1_USB_PLAY=FILE: a WAV file (PCM, 16 or 24 bits, mono or stereo, any rate) as interleaved
+/// 44.1 kHz stereo 16-bit samples (linear interpolation to 44.1 kHz).
+fn read_wav(path: &str) -> Result<Vec<i16>, String> {
+    let b = std::fs::read(path).map_err(|e| e.to_string())?;
+    if b.len() < 12 || &b[0..4] != b"RIFF" || &b[8..12] != b"WAVE" {
+        return Err("not a WAV file".into());
+    }
+    let (mut fmt, mut data, mut i) = (None, None, 12usize);
+    while i + 8 <= b.len() {
+        let n = u32::from_le_bytes([b[i + 4], b[i + 5], b[i + 6], b[i + 7]]) as usize;
+        let body = &b[i + 8..(i + 8 + n).min(b.len())];
+        match &b[i..i + 4] {
+            b"fmt " if body.len() >= 16 => {
+                fmt = Some((u16::from_le_bytes([body[0], body[1]]), u16::from_le_bytes([body[2], body[3]]),
+                            u32::from_le_bytes([body[4], body[5], body[6], body[7]]), u16::from_le_bytes([body[14], body[15]])))
+            }
+            b"data" => data = Some(body),
+            _ => {}
+        }
+        i += 8 + n + (n & 1);
+    }
+    let (tag, ch, rate, bits) = fmt.ok_or("no fmt chunk")?;
+    let data = data.ok_or("no data chunk")?;
+    if !(tag == 1 || tag == 0xfffe) || !(bits == 16 || bits == 24) || !(ch == 1 || ch == 2) || rate == 0 {
+        return Err(format!("PCM 16 or 24 bits, mono or stereo only (this: format {tag}, {ch} ch, {bits} bits)"));
+    }
+    let (bps, ch) = (bits as usize / 8, ch as usize);
+    let frames = data.len() / (bps * ch);
+    if frames == 0 {
+        return Err("no samples".into());
+    }
+    let sample = |f: usize, c: usize| -> f32 {
+        let at = (f * ch + c.min(ch - 1)) * bps;
+        if bps == 2 {
+            i16::from_le_bytes([data[at], data[at + 1]]) as f32
+        } else {
+            (i32::from_le_bytes([0, data[at], data[at + 1], data[at + 2]]) >> 16) as f32
+        }
+    };
+    let out_frames = (frames as u64 * 44_100 / rate as u64) as usize;
+    let step = rate as f64 / 44_100.0;
+    let mut out = Vec::with_capacity(2 * out_frames);
+    for k in 0..out_frames {
+        let x = k as f64 * step;
+        let (f0, t) = (x as usize, (x - x.floor()) as f32);
+        let f1 = (f0 + 1).min(frames - 1);
+        for c in 0..2 {
+            let v = sample(f0, c) + (sample(f1, c) - sample(f0, c)) * t;
+            out.push(v.round().clamp(-32768.0, 32767.0) as i16);
+        }
+    }
+    Ok(out)
+}
