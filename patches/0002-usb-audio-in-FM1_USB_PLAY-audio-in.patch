+/// --usb with FM1_USB_PLAY=FILE (or, live, --audio-in): the computer plays to the device's USB
+/// audio output at 44.1 kHz. Headless, the whole file is queued now (played once, then silence);
+/// live, it is returned for `LiveFeed` to loop. `input`: --audio-in is on (no file needed).
+fn usb_play_arm(m: &mut Machine, live: bool, input: bool) -> Option<Vec<i16>> {
+    if !m.soc.usb.cable {
+        return None;
+    }
+    let file = std::env::var("FM1_USB_PLAY").ok();
+    if file.is_none() && !input {
+        return None;
+    }
+    m.soc.usb.audio_play(44_100);
+    let path = file?;
+    match read_wav(&path) {
+        Ok(lr) => {
+            eprintln!("usb play: {path}, {:.1} s at 44100 Hz{}", lr.len() as f64 / 88_200.0, if live { ", looped" } else { "" });
+            if live {
+                return Some(lr);
+            }
+            m.soc.usb.play_push(&lr);
+            None
+        }
+        Err(e) => {
+            eprintln!("usb play: {path}: {e}");
+            None
+        }
+    }
+}
+
+/// --usb with FM1_USB_PLAY: how the playing went.
+fn usb_play_report(m: &Machine) {
+    let u = &m.soc.usb;
+    if std::env::var_os("FM1_USB_PLAY").is_none() || !u.cable {
+        return;
+    }
+    match &u.play_stream {
+        None => println!("usb play: the device has no USB audio output (playback interface); nothing played"),
+        Some(a) if u.play_packets == 0 => println!("usb play: {} ch x {} B, never started (the device didn't take its setting)", a.channels, a.sample_bytes),
+        Some(a) => println!("usb play: {} ch x {} B at {} Hz, {} packets ({} lost: the device had no room), {} frames of silence (nothing queued), {} frames left",
+                            a.channels, a.sample_bytes, u.play_rate, u.play_packets, u.play_lost, u.play_starved, u.play_queued()),
+    }
+}
